# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials).
# Free tier: ~100 searches/day. Without it, search is disabled and
# paste-a-YouTube-URL still works.
YOUTUBE_API_KEY=

# Last.fm API key (https://www.last.fm/api/account/create — free).
# Powers song suggestions via similar-track recommendations. Without it,
# suggestions fall back to plain title search.
LASTFM_API_KEY=