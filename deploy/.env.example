# Copy to the repo root on the VM as `.env` and fill in.
# NEVER commit the real .env (it is gitignored).
LASTFM_API_KEY=your_lastfm_api_key

# Required on datacenter-hosted deploys (e.g. Oracle): YouTube bot-gates
# anonymous playback from datacenter IPs even with PO tokens. Paste the full
# Cookie header of a logged-in youtube.com request from your browser DevTools
# (Network tab → any youtube.com request → Request Headers → cookie).
# Prefer a throwaway account — YouTube may flag it. Never commit this.
YOUTUBE_COOKIE=

# Optional overrides (defaults shown)
SERVER_PORT=3001
SERVER_HOST=0.0.0.0